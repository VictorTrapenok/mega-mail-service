#!/bin/bash
# {{ ansible_managed }}
#
# Sampler of container resource consumption. There is deliberately no Prometheus at this
# stage: what is needed is six numbers, not a monitoring system.

set -u
OUT="$1"
INTERVAL={{ bench_sample_interval_s }}

echo "ts,container,cpu_pct,mem_used,mem_limit" > "$OUT"

while true; do
  TS=$(date +%s)
  docker stats --no-stream --format '{% raw %}{{.Name}},{{.CPUPerc}},{{.MemUsage}}{% endraw %}' 2>/dev/null \
    | sed 's/%//; s/ \/ /,/' \
    | while IFS= read -r line; do echo "${TS},${line}"; done >> "$OUT"

  sleep "$INTERVAL"
done
