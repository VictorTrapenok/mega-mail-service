#!/bin/bash
# {{ ansible_managed }}
#
# Queue sampler. Writes CSV every {{ bench_sample_interval_s }} s.
#
# The parentheses in the condition are placed explicitly. In Postal's own stock
# script/queue_size.rb the AND/OR precedence is mixed up, which makes locked rows
# count as "ready" as well, and the queue depth is systematically overstated.
#
# The readiness threshold is not "now" but "30 seconds ago": the worker selects rows
# with the ready_with_delayed_retry scope, i.e. retry_after < 30.seconds.ago.
# Counting as ready something the worker will not take yet means showing in the report
# a backlog of work it does not have.

set -u
OUT="$1"
INTERVAL={{ bench_sample_interval_s }}

echo "ts,total,ready,in_flight,oldest_ready_age_s" > "$OUT"

while true; do
  docker exec -i {{ mariadb_container }} mariadb \
      -u{{ mariadb_postal_user }} -p{{ mariadb_postal_password }} \
      -D {{ postal_main_db_name }} -N -B -e "
    SELECT
      UNIX_TIMESTAMP(),
      COUNT(*),
      SUM(CASE WHEN locked_at IS NULL
                AND (retry_after IS NULL
                     OR retry_after < UTC_TIMESTAMP() - INTERVAL 30 SECOND)
               THEN 1 ELSE 0 END),
      SUM(CASE WHEN locked_at IS NOT NULL THEN 1 ELSE 0 END),
      IFNULL(TIMESTAMPDIFF(SECOND,
             MIN(CASE WHEN locked_at IS NULL THEN created_at END),
             UTC_TIMESTAMP()), 0)
    FROM queued_messages;" 2>/dev/null | tr '\t' ',' >> "$OUT"

  sleep "$INTERVAL"
done
