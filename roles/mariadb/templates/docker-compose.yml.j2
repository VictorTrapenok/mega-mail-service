{{ ansible_managed | comment }}
name: stand-db

services:
  mariadb:
    image: {{ mariadb_image_ref }}
    restart: unless-stopped
    environment:
      MARIADB_ROOT_PASSWORD: "{{ mariadb_root_password }}"
      MARIADB_DATABASE: "{{ postal_main_db_name }}"
      MARIADB_USER: "{{ mariadb_postal_user }}"
      MARIADB_PASSWORD: "{{ mariadb_postal_password }}"
    ports:
      - "{{ svc_ip }}:{{ mariadb_port }}:3306"
    volumes:
      - {{ mariadb_dir }}/conf.d:/etc/mysql/conf.d:ro
      - stand_db_data:/var/lib/mysql
    healthcheck:
      test: ["CMD", "healthcheck.sh", "--connect", "--innodb_initialized"]
      interval: 10s
      timeout: 5s
      retries: 12
      start_period: 60s
    deploy:
      resources:
        limits:
          cpus: "{{ mariadb_limits.cpus }}"
          memory: "{{ mariadb_limits.memory }}"
{% if mariadb_cpuset %}
    # cpuset rather than a CPU quota: the CFS quota throttles the container at
    # 100 ms period boundaries while reporting an average load noticeably below 100 %.
    cpuset: "{{ mariadb_cpuset }}"
{% endif %}

volumes:
  # A named volume: reset in snapshot mode recreates exactly this one,
  # and it is the only way to equalise buffer pool warmth
  # and tablespace layout between runs.
  stand_db_data: {}
