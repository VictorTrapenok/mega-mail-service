{{ ansible_managed | comment }}
#
# The topology mirrors postalserver/install: three long-lived processes from a SINGLE
# image, differing only in the command argument, plus a runner for one-off
# operations. RabbitMQ and the cron/requeuer processes were removed in Postal 3.0 —
# the queue lives in MariaDB.
#
# network_mode: host is not an optimisation but a requirement: the worker determines its
# outbound addresses by enumerating the interfaces of its own netns
# (Socket.ip_address_list) and only takes rows from the queue whose
# ip_address_id matched or is NULL. On a bridge network it sees 172.x,
# matches no row in ip_addresses, and with pools enabled
# processes nothing — silently, without errors and without a single log line.

name: stand-postal

x-postal-common: &postal-common
  image: {{ postal_image_resolved }}
  restart: unless-stopped
  network_mode: host
  volumes:
    - {{ postal_config_dir }}:/config
    - {{ test_dns_resolv_conf }}:/etc/postal-resolv.conf:ro
  environment: &postal-env
    MAIN_DB_HOST: "{{ postal_main_db_addr }}"
    MAIN_DB_PORT: "{{ mariadb_port }}"
    MAIN_DB_USERNAME: "{{ mariadb_postal_user }}"
    MAIN_DB_PASSWORD: "{{ mariadb_postal_password }}"
    MAIN_DB_DATABASE: "{{ postal_main_db_name }}"
    MAIN_DB_POOL_SIZE: "{{ postal_main_db_pool_size }}"

    MESSAGE_DB_HOST: "{{ postal_message_db_addr }}"
    MESSAGE_DB_PORT: "{{ mariadb_port }}"
    MESSAGE_DB_USERNAME: "{{ mariadb_postal_user }}"
    MESSAGE_DB_PASSWORD: "{{ mariadb_postal_password }}"
    MESSAGE_DB_DATABASE_NAME_PREFIX: "{{ postal_message_db_prefix }}"

    POSTAL_WEB_HOSTNAME: "{{ postal_web_hostname }}"
    POSTAL_SMTP_HOSTNAME: "{{ postal_smtp_hostname }}"
    POSTAL_USE_IP_POOLS: "{{ postal_use_ip_pools | lower }}"
    POSTAL_BATCH_QUEUED_MESSAGES: "{{ postal_batch_queued_messages | lower }}"
    # TidyQueuedMessagesTask DESTROYS messages with a stale lock
    # instead of reopening them. We set a value knowingly larger than the run duration.
    POSTAL_QUEUED_MESSAGE_LOCK_STALE_DAYS: "{{ postal_queued_message_lock_stale_days }}"
    # Defaults to false, in which case Postal first resolves the domain's NS,
    # which does not work in .test and silently breaks verification.
    POSTAL_USE_LOCAL_NS_FOR_DOMAIN_VERIFICATION: "{{ postal_use_local_ns_for_domain_verification | lower }}"
{% if postal_smtp_relays %}
    POSTAL_SMTP_RELAYS: "{{ postal_smtp_relays | join(',') }}"
{% endif %}

    # The bench resolver. We do not touch the host's /etc/resolv.conf: with host
    # networking Postal would inherit systemd-resolved on 127.0.0.53.
    DNS_RESOLV_CONF_PATH: "/etc/postal-resolv.conf"
    DNS_TIMEOUT: "{{ postal_dns.timeout }}"
    DNS_HELO_HOSTNAME: "{{ postal_dns.helo_hostname }}"
    DNS_MX_RECORDS: "{{ postal_dns.mx_records | join(',') }}"
    DNS_SPF_INCLUDE: "{{ postal_dns.spf_include }}"
    DNS_RETURN_PATH_DOMAIN: "{{ postal_dns.return_path_domain }}"
    DNS_ROUTE_DOMAIN: "{{ postal_dns.route_domain }}"
    DNS_TRACK_DOMAIN: "{{ postal_dns.track_domain }}"
    DNS_DOMAIN_VERIFY_PREFIX: "{{ postal_dns.domain_verify_prefix }}"
    DNS_CUSTOM_RETURN_PATH_PREFIX: "{{ postal_dns.custom_return_path_prefix }}"

{# Postal refuses outbound webhook and HTTP-endpoint requests whose destination resolves to
   a private, loopback or link-local address — Postal::HTTP::AddressGuard, SSRF protection.
   The bench's webhook sink sits on an RFC1918 address, so without an allowlist entry every
   webhook fails with code -4 while the feature still looks enabled: the requests are
   created, retried and recorded, and nothing ever arrives. Measured, not assumed. #}
{% set webhook_destinations = ((groups['postal_load_balancers'] | default([])) | map('extract', hostvars, 'svc_ip') | list)
                              + (postal_allowed_request_destinations | default([])) %}
{% if webhook_destinations %}
    POSTAL_ALLOWED_REQUEST_DESTINATIONS: "{{ webhook_destinations | join(',') }}"
{% endif %}

    LOGGING_ENABLED: "true"
    LOGGING_HIGHLIGHTING_ENABLED: "false"

services:
{% if inventory_hostname in (groups['postal_web'] | default([])) %}
{# There is more than one ingress replica because MRI Ruby has a GVL: a single Puma
   process does not perform CPU-bound work — building multipart, quoted-printable, DKIM
   signing — on more than one core. The measurement confirms it: web topped out at
   exactly 92.5 % under a 1.0 CPU limit. Ingress scales by processes,
   not by threads, and giving one process more cores achieves nothing. #}
{% for i in range(postal_web_replicas | int) %}
  web{{ i + 1 }}:
    <<: *postal-common
    hostname: postal-web{{ i + 1 }}-{{ inventory_hostname }}
    command: ["postal", "web-server"]
    environment:
      <<: *postal-env
      # The default is 127.0.0.1, and with host networking web would be reachable
      # only locally.
      WEB_SERVER_DEFAULT_BIND_ADDRESS: "0.0.0.0"
      WEB_SERVER_DEFAULT_PORT: "{{ postal_web_port + i }}"
      WEB_SERVER_MAX_THREADS: "{{ postal_web_max_threads }}"
    healthcheck:
      # Before postal initialize there are no tables yet, so /login predictably
      # returns 500. Here we only check that Puma is listening on the port; the HTTP path
      # is checked after the schema is initialised.
      test: ["CMD", "ruby", "-e", "require 'socket'; TCPSocket.new('127.0.0.1', {{ postal_web_port + i }}).close"]
      interval: 15s
      timeout: 5s
      retries: 5
      start_period: 60s
    deploy:
      resources:
        limits:
          cpus: "{{ postal_limits.web.cpus }}"
          memory: "{{ postal_limits.web.memory }}"
{% if postal_cpuset %}
    cpuset: "{{ postal_cpuset }}"
{% endif %}
{% endfor %}
{% endif %}

{% if inventory_hostname in (groups['postal_smtp'] | default([])) %}
  smtp:
    <<: *postal-common
    hostname: postal-smtp-{{ inventory_hostname }}
    command: ["postal", "smtp-server"]
    environment:
      <<: *postal-env
      # Ingress is moved off 25: an MX record does not carry a port, so 25 must be
      # occupied by the sink, whereas the generator is ours and will go wherever it is told.
      SMTP_SERVER_DEFAULT_PORT: "{{ postal_smtp_port }}"
      SMTP_SERVER_DEFAULT_BIND_ADDRESS: "0.0.0.0"
      SMTP_SERVER_DEFAULT_HEALTH_SERVER_PORT: "{{ postal_smtp_health_port_base }}"
      SMTP_SERVER_DEFAULT_HEALTH_SERVER_BIND_ADDRESS: "0.0.0.0"
      SMTP_SERVER_TLS_ENABLED: "{{ postal_smtp_tls_enabled | lower }}"
      SMTP_SERVER_MAX_MESSAGE_SIZE: "{{ postal_smtp_max_message_size }}"
    healthcheck:
      test: ["CMD", "ruby", "-e", "require 'net/http'; exit(Net::HTTP.get_response(URI('http://127.0.0.1:{{ postal_smtp_health_port_base }}/health')).code == '200' ? 0 : 1)"]
      interval: 15s
      timeout: 5s
      retries: 5
      start_period: 30s
    deploy:
      resources:
        limits:
          cpus: "{{ postal_limits.smtp.cpus }}"
          memory: "{{ postal_limits.smtp.memory }}"
{% if postal_cpuset %}
    cpuset: "{{ postal_cpuset }}"
{% endif %}
{% endif %}

{% if inventory_hostname in (groups['postal_workers'] | default([])) %}
{% for i in range(postal_worker_replicas | int) %}
  worker{{ i + 1 }}:
    <<: *postal-common
    # A unique hostname is mandatory: batchable_messages claims rows
    # by the UNsuffixed locker name, so containers with the same
    # hostname pick up each other's batches and produce duplicate deliveries.
    hostname: postal-worker{{ i + 1 }}-{{ inventory_hostname }}
    command: ["postal", "worker"]
    environment:
      <<: *postal-env
      WORKER_THREADS: "{{ postal_worker_threads }}"
      # One port per replica: when the port is taken, the health server catches
      # EADDRINUSE and merely writes to the log, so the second and further replicas
      # would silently be left without metrics.
      WORKER_DEFAULT_HEALTH_SERVER_PORT: "{{ postal_worker_health_port_base + i }}"
      WORKER_DEFAULT_HEALTH_SERVER_BIND_ADDRESS: "0.0.0.0"
    healthcheck:
      test: ["CMD", "ruby", "-e", "require 'net/http'; exit(Net::HTTP.get_response(URI('http://127.0.0.1:{{ postal_worker_health_port_base + i }}/health')).code == '200' ? 0 : 1)"]
      interval: 15s
      timeout: 5s
      retries: 5
      start_period: 30s
    deploy:
      resources:
        limits:
          cpus: "{{ postal_limits.worker.cpus }}"
          memory: "{{ postal_limits.worker.memory }}"
{% if postal_cpuset %}
    cpuset: "{{ postal_cpuset }}"
{% endif %}
{% endfor %}
{% endif %}

{% if inventory_hostname in (groups['postal_admin'] | default([])) %}
  runner:
    <<: *postal-common
    restart: "no"
    profiles: ["tools"]
    command: ["postal"]
    volumes:
      - {{ postal_config_dir }}:/config
      - {{ test_dns_resolv_conf }}:/etc/postal-resolv.conf:ro
      - {{ postal_dir }}/scripts:/scripts:ro
{% endif %}
