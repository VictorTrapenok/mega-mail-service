{{ ansible_managed | comment }}
name: stand-dns

services:
  coredns:
    image: {{ coredns_image_ref }}
    restart: unless-stopped
    command: ["-conf", "/etc/coredns/Corefile"]
    # Host networking for the same reason as on the sink: publishing a port
    # would mean DNAT, and the resolver is queried both by Postal containers
    # on the host network and by host processes. The listening address is set
    # by the bind directive in the Corefile — 0.0.0.0:53 would take the port
    # needed by systemd-resolved.
    network_mode: host
    volumes:
      - {{ test_dns_dir }}:/etc/coredns:ro
