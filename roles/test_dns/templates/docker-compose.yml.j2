{{ ansible_managed | comment }}
name: stand-dns

services:
  coredns:
    image: {{ coredns_image_ref }}
    restart: unless-stopped
    command: ["-conf", "/etc/coredns/Corefile"]
    # Host-сеть по той же причине, что и у приёмника: публикация порта
    # означала бы DNAT, а к резолверу обращаются и контейнеры Postal
    # в host-сети, и хостовые процессы. Адрес прослушивания задаётся
    # директивой bind в Corefile — 0.0.0.0:53 занял бы порт,
    # нужный systemd-resolved.
    network_mode: host
    volumes:
      - {{ test_dns_dir }}:/etc/coredns:ro
