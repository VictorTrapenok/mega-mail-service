{{ ansible_managed | comment }}

{{ postal_test_domain }}:{{ test_dns_port }} {
    # A specific address rather than 0.0.0.0: systemd-resolved sits on 127.0.0.53.
    bind {{ test_dns_addr }}
    file /etc/coredns/{{ postal_test_domain }}.zone

    # The destination domains d0001..dNNNN are not stored in the zone: there are a thousand
    # of them and they all answer identically.
    # One MX record per sink with the SAME priority:
    # DNSResolver#mx randomises records of equal priority, and the load
    # spreads by itself. Several A records on one name would not give that,
    # but a failover walk — Postal tries the addresses in order.
    template IN MX {{ postal_test_domain }} {
        match "^{{ test_dns_destination_prefix }}[0-9]+\.{{ postal_test_domain | replace('.', '\\.') }}\.$"
{% for h in groups['postfix_sinks'] | default([]) %}
        answer "{{ '{{' }} .Name {{ '}}' }} 60 IN MX {{ test_dns_mx_priority }} sink-{{ loop.index }}.{{ postal_test_domain }}."
{% endfor %}
    }

    errors
    log
}

. {
    bind {{ test_dns_addr }}
    # There are deliberately no forwarders: external domains do not resolve at all
    # rather than merely being blocked by the firewall. This is a separate containment line —
    # it fires before the nftables rule and does not depend on it.
    template ANY ANY {
        rcode NXDOMAIN
    }
    errors
}
