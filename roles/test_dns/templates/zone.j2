{{ ansible_managed | comment(decoration='; ') }}
$ORIGIN {{ postal_test_domain }}.
$TTL 60

@   IN SOA ns.{{ postal_test_domain }}. admin.{{ postal_test_domain }}. (
        1          ; serial — a lab zone, versioning is not needed
        3600       ; refresh
        600        ; retry
        86400      ; expire
        60 )       ; minimum

@                   IN NS    ns.{{ postal_test_domain }}.
ns                  IN A     {{ test_dns_addr }}

; --- Bench infrastructure -------------------------------------------------
{# postal.<domain> is POSTAL_WEB_HOSTNAME: it is exactly what Rails checks
   in the Host header, and it is the name the generator uses to reach the API. #}
postal              IN A     {{ postal_web_addrs | first }}
{% for h in groups['postfix_sinks'] | default([]) %}
sink-{{ loop.index }}         IN A     {{ hostvars[h].svc_ip }}
{% endfor %}

; HELO names of the outbound addresses. Postal takes the HELO from ip_addresses.hostname,
; and the receiving side must be able to resolve them.
{% for h in groups['postal_workers'] | default([]) %}
{% for ip in hostvars[h].postal_sending_ips | default([]) %}
{{ ip.hostname | replace('.' ~ postal_test_domain, '') }}    IN A     {{ ip.ipv4 }}
{% endfor %}
{% endfor %}

; --- Sender domain records ------------------------------------------------
; Filled in on the second pass, after seeding: the name and the value of the DKIM record
; are generated by Postal itself (Domain#before_create :generate_dkim_key), they cannot
; be known in advance.
{% if postal_seed is defined %}
@                   IN TXT   "v=spf1 a mx include:{{ postal_dns.spf_include }} ~all"
{# Domain#dns_verification_string already returns the string together with the prefix
   ("<prefix> <token>"), so the prefix must not be added a second time —
   verify_with_dns would then find no match. #}
@                   IN TXT   "{{ postal_seed.dns_verification_string }}"
{{ postal_seed.dkim_record_name }} IN TXT ( "{{ postal_seed.dkim_record }}" )
{{ postal_dns.custom_return_path_prefix }} IN CNAME {{ postal_dns.return_path_domain }}.
{% endif %}

; The SPF include and the return path must resolve, otherwise domain verification
; in Postal will not pass, and without verified_at any send fails with
; 530 From/Sender name is not valid.
spf                 IN TXT   "v=spf1 ip4:{{ postal_smtp_addrs | first }} ~all"
rp                  IN A     {{ postal_smtp_addrs | first }}
routes              IN A     {{ postal_web_addrs | first }}
track               IN A     {{ postal_web_addrs | first }}
