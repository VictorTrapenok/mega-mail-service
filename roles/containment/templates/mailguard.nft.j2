#!/usr/sbin/nft -f
{{ ansible_managed | comment }}

# The atomic reload idiom: add creates the table if it does not exist,
# delete then removes it for sure, and afterwards it is built again from scratch.
add table inet mailguard
delete table inet mailguard

table inet mailguard {
    # A named counter: the smoke test asserts that it stayed at zero.
    # Without it, "no message escaped to the outside" is a hope, not a check.
    counter smtp_escape_attempts {}

    set stand_hosts {
        type ipv4_addr
        elements = {
{% for addr in containment_allowed_addrs %}
            {{ addr }}{{ "," if not loop.last else "" }}
{% endfor %}
        }
    }

    # The traffic of containers with network_mode: host is the host's own traffic
    # and goes through output. Containers on a bridge network go through forward.
    # Both chains are needed: filtering in only one of them is the classic
    # mistake that leaves a hole in exactly the topology that was not tested.

    chain output {
        type filter hook output priority filter; policy accept;
        oif "lo" accept
        ip daddr @stand_hosts accept
        tcp dport { {{ containment_ports | join(', ') }} } counter name smtp_escape_attempts {{ containment_verdict }}
    }

    chain forward {
        type filter hook forward priority filter; policy accept;
        ip daddr @stand_hosts accept
        tcp dport { {{ containment_ports | join(', ') }} } counter name smtp_escape_attempts {{ containment_verdict }}
    }
}
