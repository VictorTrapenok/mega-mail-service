# {{ ansible_managed }}
#
# Seeding of Postal data.
#
# Postal has no administrative API: config/routes.rb exposes only
# /api/v1/send/* and /api/v1/messages/*, everything else is HTML controllers behind a session.
# The only object-creating CLI command, postal make-user, is interactive
# (HighLine). Raw SQL is dangerous: Server creates its own message DB in after_create,
# and Domain generates the DKIM key in before_create.
#
# Hence rails runner, and only through the models.

require "json"

user = User.find_or_initialize_by(email_address: {{ postal_admin_email | to_json }})
if user.new_record?
  user.first_name = {{ postal_admin_first_name | to_json }}
  user.last_name  = {{ postal_admin_last_name | to_json }}
  user.password   = {{ postal_admin_password | to_json }}
  user.password_confirmation = {{ postal_admin_password | to_json }}
  user.admin = true
  user.email_verified_at = Time.now
  user.save!
end

org = Organization.find_or_initialize_by(permalink: {{ postal_organization_permalink | to_json }})
if org.new_record?
  org.name = {{ postal_organization_name | to_json }}
  org.owner_id = user.id
  org.save!
end

OrganizationUser.find_or_create_by!(organization_id: org.id, user_id: user.id) do |ou|
  ou.admin = true
  ou.all_servers = true
  ou.user_type = "User"
end

# Server calls message_db.provisioner.provision in after_create —
# without that the server's separate message database simply never appears.
server = Server.find_or_initialize_by(organization_id: org.id,
                                      permalink: {{ postal_server_permalink | to_json }})
if server.new_record?
  server.name = {{ postal_server_name | to_json }}
  server.mode = "Live"
  server.save!
end

# We clear the send limit and retention: otherwise some messages end up Held
# because of send_limit, and the daily cleanup task may drop the raw table
# in the middle of a run. These are server columns, not environment variables.
server.update_columns(
  send_limit: nil,
  message_retention_days: nil,
  raw_message_retention_days: nil,
  raw_message_retention_size: nil
)

domain = Domain.find_or_initialize_by(owner_type: "Server", owner_id: server.id,
                                      name: {{ postal_test_domain | to_json }})
if domain.new_record?
  domain.server_id = server.id
  domain.verification_method = "DNS"
  domain.outgoing = true
  domain.incoming = true
  domain.use_for_any = true
  domain.save!
end

# Credential#generate_key unconditionally sets the key of a new record, and
# validate_key_cannot_be_changed forbids changing it through the model. Hence we
# pin the value via update_column: otherwise re-running the seed
# would silently rotate the keys, the generator would start getting 535, and that would look
# like a regression of the build under test.
def pin_credential(server, type, name, key)
  cred = Credential.find_or_initialize_by(server_id: server.id, type: type, name: name)
  cred.save! if cred.new_record?
  cred.update_column(:key, key) unless cred.key == key
  cred.reload
end

api_cred  = pin_credential(server, "API",  "bench-api",  {{ postal_api_key | to_json }})
smtp_cred = pin_credential(server, "SMTP", "bench-smtp", {{ postal_smtp_key | to_json }})

{% if postal_use_ip_pools %}
pool = IPPool.find_or_create_by!(name: "bench") { |p| p.default = true }
OrganizationIPPool.find_or_create_by!(organization_id: org.id, ip_pool_id: pool.id)
server.update_column(:ip_pool_id, pool.id)

{% for h in groups['postal_workers'] | default([]) %}
{% for ip in hostvars[h].postal_sending_ips | default([]) %}
# The address must be physically present on the worker: it only takes rows from the
# queue whose ip_address_id matched an address of its own netns or is
# NULL. Otherwise the queue stalls silently — the orphaned rows are not even seen by the
# tidy task, because their locked_at IS NULL.
IPAddress.find_or_create_by!(ipv4: {{ ip.ipv4 | to_json }}) do |a|
  a.ip_pool_id = pool.id
  a.hostname = {{ ip.hostname | to_json }}
  a.priority = 100
end
{% endfor %}
{% endfor %}
{% endif %}

{% if postal_force_domain_verification %}
# Bypassing the DNS check. Flagged in the report as reduced credibility:
# the only gate on sending is verified_at, but resolution still remains
# on the hot delivery path and is a bottleneck candidate in its own right.
domain.mark_as_verified unless domain.verified?
{% endif %}

domain.reload

# The message database name is needed by the reconciliation and the queue sampler. We take it
# from Postal itself. There is deliberately no fallback here: a wrong database name would mean
# that the whole reconciliation silently counts an empty selection, and failing at this point
# is preferable.
message_db_name = server.message_db.database_name

puts "POSTAL_SEED_JSON:" + {
  server_id: server.id,
  server_token: server.token,
  organization_id: org.id,
  message_db_name: message_db_name,
  domain_id: domain.id,
  domain_name: domain.name,
  domain_verified: !domain.verified_at.nil?,
  dkim_record_name: domain.dkim_record_name,
  dkim_record: domain.dkim_record,
  spf_record: domain.spf_record,
  dns_verification_string: domain.dns_verification_string,
  api_key: api_cred.key,
  smtp_key: smtp_cred.key
}.to_json
