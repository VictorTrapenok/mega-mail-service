#-# {{ ansible_managed }}
#
# The Postal HTTP API load balancer.
#
# It exists because ingress scales by processes, not by threads:
# MRI Ruby has a GVL, and a single Puma process does not perform compute work
# on more than one core. Talking to the first of several processes
# would mean measuring one process instead of the system.
#
# HTTP only. Balancing SMTP is forbidden: HAProxy terminates TCP,
# and the sink would see its address instead of the outbound one that Postal bound
# to the socket — that destroys the only end-to-end proof of IP binding.

global
    maxconn {{ postal_lb_maxconn }}
    log stdout format raw local0 info

defaults
    mode http
    log global
    option httplog
    maxconn {{ postal_lb_maxconn }}
    timeout connect 5s
    # The timeouts are knowingly larger than the worst observed ingress latency:
    # under overload it reached a minute, and a balancer cutting the connection
    # earlier would show Postal failures where there are none.
    timeout client {{ postal_lb_timeout }}
    timeout server {{ postal_lb_timeout }}
    timeout http-request {{ postal_lb_timeout }}

frontend api
    bind {{ svc_ip }}:{{ postal_lb_port }}
    default_backend postal_web

backend postal_web
    balance roundrobin
    # The check only establishes a TCP connection, just like the healthcheck of the
    # containers themselves: before postal initialize there are no tables yet, and the HTTP path
    # predictably returns 500, which would make httpchk take live processes out of rotation.
{# The replica count is taken from the facts of EACH web host rather than from this host's
   variable: the template is rendered on the balancer, and its own value applies
   to itself. Ingress hosts may carry different numbers of processes. #}
{% for h in groups['postal_web'] | default([]) %}
{% for i in range(hostvars[h].postal_web_replicas | int) %}
    server web-{{ h }}-{{ i + 1 }} {{ hostvars[h].svc_ip }}:{{ postal_web_port + i }} check inter 5s rise 2 fall 3
{% endfor %}
{% endfor %}

listen stats
    bind {{ svc_ip }}:{{ postal_lb_stats_port }}
    stats enable
    stats uri /
    # The distribution across ingress processes must be visible: a skew means that
    # some of them are not working, and ingress was measured on a different number of
    # processes than the report records.
    stats refresh 5s
