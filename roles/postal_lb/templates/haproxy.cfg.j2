#-# {{ ansible_managed }}
#
# Балансировщик HTTP API Postal.
#
# Существует потому, что приём масштабируется процессами, а не потоками:
# у MRI Ruby есть GVL, и один процесс Puma не выполняет счётную работу
# больше чем на одном ядре. Обращаться к первому процессу из нескольких
# значило бы измерять один процесс вместо системы.
#
# Только HTTP. Балансировать SMTP запрещено: HAProxy терминирует TCP,
# и приёмник увидел бы его адрес вместо исходящего, который Postal привязал
# к сокету, — это уничтожает единственное сквозное доказательство привязки IP.

global
    maxconn {{ postal_lb_maxconn }}
    log stdout format raw local0 info

defaults
    mode http
    log global
    option httplog
    maxconn {{ postal_lb_maxconn }}
    timeout connect 5s
    # Таймауты заведомо больше худшей наблюдавшейся латентности приёма:
    # под перегрузом она доходила до минуты, и балансировщик, обрывающий
    # соединение раньше, показал бы отказы Postal там, где их нет.
    timeout client {{ postal_lb_timeout }}
    timeout server {{ postal_lb_timeout }}
    timeout http-request {{ postal_lb_timeout }}

frontend api
    bind {{ svc_ip }}:{{ postal_lb_port }}
    default_backend postal_web

backend postal_web
    balance roundrobin
    # Проверка только на установление TCP-соединения, как и healthcheck самих
    # контейнеров: до postal initialize таблиц ещё нет, и HTTP-путь закономерно
    # отдаёт 500, из-за чего httpchk выводил бы живые процессы из ротации.
{# Число реплик берётся из фактов КАЖДОГО web-хоста, а не из переменной этого:
   шаблон рендерится на балансировщике, и его собственное значение относится
   к нему самому. Хосты приёма могут нести разное число процессов. #}
{% for h in groups['postal_web'] | default([]) %}
{% for i in range(hostvars[h].postal_web_replicas | int) %}
    server web-{{ h }}-{{ i + 1 }} {{ hostvars[h].svc_ip }}:{{ postal_web_port + i }} check inter 5s rise 2 fall 3
{% endfor %}
{% endfor %}

listen stats
    bind {{ svc_ip }}:{{ postal_lb_stats_port }}
    stats enable
    stats uri /
    # Распределение по процессам приёма нужно видеть: перекос означает, что
    # часть из них не работает, и приём измерен не на том числе процессов,
    # которое записано в отчёте.
    stats refresh 5s
