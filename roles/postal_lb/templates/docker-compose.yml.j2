# {{ ansible_managed }}
#
# The HTTP API load balancer. It runs on the host network: it must listen on svc_ip
# and reach the ingress processes directly, not through a bridge with address translation.

name: stand-lb

services:
  haproxy:
    image: "{{ haproxy_image_ref }}"
    hostname: postal-lb-{{ inventory_hostname }}
    network_mode: host
    restart: unless-stopped
    volumes:
      - "{{ postal_lb_dir }}/haproxy.cfg:/usr/local/etc/haproxy/haproxy.cfg:ro"
    healthcheck:
      test: ["CMD", "sh", "-c", "wget -q -O /dev/null http://{{ svc_ip }}:{{ postal_lb_stats_port }}/ || exit 1"]
      interval: 15s
      timeout: 5s
      retries: 5
      start_period: 10s
    # The log driver and rotation are not set here: the docker_host role sets
    # them globally in daemon.json, and the container inherits them on its own.
    deploy:
      resources:
        limits:
          cpus: "{{ postal_lb_limits.cpus }}"
          memory: "{{ postal_lb_limits.memory }}"
