{{ ansible_managed | comment }}
#
# This file DELIBERATELY lacks the outbound unix transports smtp,
# relay, lmtp, local and virtual. The inbound smtp/inet/smtpd stays: it is
# the public sink of the bench. Without the unix transports there is no process in the
# system capable of opening an outbound SMTP connection — a containment line that does not
# depend on the firewall or on routing settings.
#
# The anvil service is MANDATORY as soon as any smtpd_client_*_limit is non-zero: those
# limits are not implemented inside smtpd, they are a query to private/anvil. Without this
# line the limit is dead configuration — smtpd fails to reach the service and accepts the
# connection anyway, so the cap silently applies to nobody while every connection still pays
# for the failed lookup. That combination — no rejections yet a throughput drop — is exactly
# what an earlier run recorded and misread as the cost of anvil itself.
#
# The chroot column is "n" everywhere: the queue lives on tmpfs, and the chroot
# environment that Debian builds when installing the package is not there.
#
# service       type        private unpriv  chroot  wakeup  maxproc command
smtp            inet        n       -       n       -       {{ postfix_sink_tuning.default_process_limit }}     smtpd
  # An empty stress disables adaptive mode. Otherwise, under full load
  # Postfix restarts smtpd with -o stress=yes, changing smtpd_timeout
  # from 300 to 10 seconds and hard_error_limit from 20 to 1 — i.e. a build
  # that pushes harder is measured under different SMTP rules.
  -o stress=
pickup          unix        n       -       n       60      1       pickup
cleanup         unix        n       -       n       -       0       cleanup
qmgr            unix        n       -       n       300     1       qmgr
rewrite         unix        -       -       n       -       -       trivial-rewrite
bounce          unix        -       -       n       -       0       bounce
defer           unix        -       -       n       -       0       bounce
trace           unix        -       -       n       -       0       bounce
discard         unix        -       -       n       -       -       discard
error           unix        -       -       n       -       -       error
retry           unix        -       -       n       -       -       error
anvil           unix        -       -       n       -       1       anvil
postlog         unix-dgram  n       -       n       -       1       postlogd
