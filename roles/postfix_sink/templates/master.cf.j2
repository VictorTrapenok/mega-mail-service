{{ ansible_managed | comment }}
#
# В этом файле СОЗНАТЕЛЬНО отсутствуют исходящие unix-транспорты smtp,
# relay, lmtp, local и virtual. Входящий smtp/inet/smtpd остаётся: это
# публичный приёмник стенда. Без unix-транспортов в системе нет процесса,
# способного открыть исходящее SMTP-соединение, — это рубеж изоляции, не
# зависящий ни от файрвола, ни от настроек маршрутизации.
#
# Колонка chroot везде «n»: очередь лежит на tmpfs, и chroot-окружение,
# которое Debian собирает при установке пакета, там отсутствует.
#
# service       type        private unpriv  chroot  wakeup  maxproc command
smtp            inet        n       -       n       -       {{ postfix_sink_tuning.default_process_limit }}     smtpd
  # Пустой stress отключает адаптивный режим. Иначе при полной загрузке
  # Postfix перезапускает smtpd с -o stress=yes, меняя smtpd_timeout
  # с 300 на 10 секунд и hard_error_limit с 20 на 1 — то есть сборка,
  # которая давит сильнее, измеряется по другим правилам SMTP.
  -o stress=
pickup          unix        n       -       n       60      1       pickup
cleanup         unix        n       -       n       -       0       cleanup
qmgr            unix        n       -       n       300     1       qmgr
rewrite         unix        -       -       n       -       -       trivial-rewrite
bounce          unix        -       -       n       -       0       bounce
defer           unix        -       -       n       -       0       bounce
trace           unix        -       -       n       -       0       bounce
discard         unix        -       -       n       -       -       discard
error           unix        -       -       n       -       -       error
retry           unix        -       -       n       -       -       error
postlog         unix-dgram  n       -       n       -       1       postlogd
