{{ ansible_managed | comment }}
#
# The bench mail sink: accepts over SMTP in the normal way and discards.

myhostname = {{ postfix_sink_hostname }}
mydomain = {{ postal_test_domain }}
myorigin = $mydomain
mydestination =
inet_interfaces = all
inet_protocols = ipv4

# --- Containment ----------------------------------------------------------
# Not a single relay address. Together with master.cf, which has no outbound
# delivery services, this makes sending to the internet impossible at the configuration
# level, not only through firewall rules.
relayhost =
notify_classes =
smtpd_relay_restrictions = permit_mynetworks, reject
smtpd_recipient_restrictions = permit_mynetworks, reject
mynetworks = 127.0.0.0/8{% for addr in stand_cidr %}, {{ addr }}/32{% endfor %}


# Everything goes to discard. The marker ends up in the log as "status=sent ({{ postfix_sink_discard_token }})"
# and serves as a delivery counter independent of Postal.
default_transport = discard:{{ postfix_sink_discard_token }}
transport_maps = static:discard:{{ postfix_sink_discard_token }}
local_recipient_maps =

# --- Logging --------------------------------------------------------------
# We write to a file through postlogd, bypassing journald: by default the latter caps at about
# 333 lines per second per service, while the sink at 300 msg/s writes about 2100.
# Lost lines look like lost messages in the reconciliation.
maillog_file = /var/log/postfix/postfix.log

# --- Performance ----------------------------------------------------------
{% for key, value in postfix_sink_tuning | dictsort %}
{{ key }} = {{ value }}
{% endfor %}

message_size_limit = {{ postfix_sink_message_size_limit }}

# HELO checks and delayed rejects only add work: there is a single trusted client
# here.
smtpd_helo_required = no
smtpd_delay_reject = no
biff = no
append_dot_mydomain = no

queue_directory = /var/spool/postfix
compatibility_level = 3.6
