{{ ansible_managed | comment }}
name: stand-sink

services:
  sink:
    image: {{ postfix_sink_image }}
    build:
      context: {{ postfix_sink_dir }}/build
    restart: unless-stopped
    hostname: {{ postfix_sink_hostname }}
    # Host networking rather than port publishing. When publishing, Docker performs DNAT,
    # and that breaks the bench twice over: the nftables rule in the forward chain sees
    # an already-translated destination address (the container's address) and rejects the mail,
    # while Postfix itself sees a translated source address (the bridge network gateway),
    # which is not in mynetworks, and answers "554 relay access denied".
    # There is no port conflict: Postal ingress sits on 2525.
    network_mode: host
    volumes:
      - {{ postfix_sink_dir }}/conf/main.cf:/etc/postfix/main.cf:ro
      - {{ postfix_sink_dir }}/conf/master.cf:/etc/postfix/master.cf:ro
      - {{ postfix_sink_dir }}/log:/var/log/postfix
    tmpfs:
      # The queue in memory: with the discard transport a message travels the full path
      # with an fsync before the 250 reply, and on an ordinary disk the ingress ceiling
      # is determined by the fsync latency rather than by Postfix.
      - /var/spool/postfix:size={{ postfix_sink_spool_tmpfs_size }},mode=0755
    healthcheck:
      test: ["CMD", "postfix", "status"]
      interval: 15s
      timeout: 5s
      retries: 3
      start_period: 20s
    deploy:
      resources:
        limits:
          cpus: "{{ sink_limits.cpus }}"
          # The limit must exceed the queue tmpfs: tmpfs pages count towards
          # the container's memory, so a queue that filled the tmpfs would otherwise
          # get Postfix OOM-killed.
          memory: "{{ sink_limits.memory }}"
{% if sink_cpuset %}
    cpuset: "{{ sink_cpuset }}"
{% endif %}
