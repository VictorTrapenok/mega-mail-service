---
extends: default

rules:
  line-length:
    max: 140
    level: warning
  comments:
    min-spaces-from-content: 1
  truthy:
    allowed-values: ["true", "false"]
    check-keys: false
  braces:
    max-spaces-inside: 1
  octal-values:
    forbid-implicit-octal: true

# vendor/ holds the upstream Postal fork. It is someone else's code: linting it would
# report on someone else's style, and every finding would be noise against the diff we own.
ignore: |
  .github/
  reports/
  vendor/
