---
extends: default

rules:
  line-length:
    max: 140
    level: warning
  comments:
    min-spaces-from-content: 1
  truthy:
    allowed-values: ["true", "false"]
    check-keys: false
  braces:
    max-spaces-inside: 1
  octal-values:
    forbid-implicit-octal: true

# Two directories here hold code that is not ours, and linting either of them reports on
# somebody else's style: vendor/ is the upstream Postal fork, and collections/ is whatever
# "ansible-galaxy collection install" downloads — the lint job installs it itself, one step
# before running this, so on a runner it is always there even though it is gitignored.
ignore: |
  .github/
  reports/
  vendor/
  collections/
