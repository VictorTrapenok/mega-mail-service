---
profile: moderate

exclude_paths:
  - .github/
  - reports/
  - .ansible_facts/
  # The vendored Postal fork. Its YAML is a Rails application's, not Ansible's.
  - vendor/

skip_list:
  # Test-bench roles are only ever launched by their own playbooks, so they
  # do not need Galaxy metadata.
  - meta-no-info
  # Lifecycle playbooks (reset, benchmark, calibrate) are non-idempotent
  # by design: the comparison protocol requires an identical starting state
  # before every run.
  - no-changed-when

warn_list:
  - experimental
  - command-instead-of-module
