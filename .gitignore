# Ansible fact cache
.ansible_facts/
*.retry

# Run artifacts: reports are committed, raw CSV files are not.
reports/**/raw/
reports/**/*.csv.gz

# Collections installed locally
collections/

# Secrets that must never be in the repository:
# fork deploy key, registry credentials, production DKIM keys, production dumps.
*.pem
*.p12
id_rsa*
.registry-auth
dumps/

__pycache__/
*.pyc
.venv/
reports/*
