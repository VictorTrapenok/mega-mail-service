# Ansible fact cache
.ansible_facts/
*.retry

# Run artifacts.
#
# A report is small text and worth keeping; the CSV samples and generator summaries that
# accompany it are neither. And a report is only worth committing when it is a REFERENCE
# point rather than one of many iterations — a repository holding thirty runs with numbers
# that contradict each other tells a reader nothing.
#
# So the directory is ignored wholesale and the reference runs live in reports/reference/
# under names that say what they are. Everything a run produces still lands on disk.
reports/*
!reports/reference/
!reports/README.md

# Collections installed locally
collections/

# Secrets that must never be in the repository:
# fork deploy key, registry credentials, production DKIM keys, production dumps.
*.pem
*.p12
id_rsa*
.registry-auth
dumps/

__pycache__/
*.pyc
.venv/

# ansible-lint working directory
.ansible/
